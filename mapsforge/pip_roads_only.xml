<?xml version="1.0" encoding="UTF-8"?>
<rendertheme xmlns="http://mapsforge.org/renderTheme"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    map-background="#001604"
    map-background-outside="#001604"
    version="5"
    xsi:schemaLocation="http://mapsforge.org/renderTheme https://raw.githubusercontent.com/mapsforge/mapsforge/master/resources/renderTheme.xsd">

    <rule e="way" k="highway" v="motorway|trunk">
        <line stroke="#007A2C" stroke-width="3.4" stroke-linecap="round" />
        <line stroke="#00F060" stroke-width="2.0" stroke-linecap="round" />
    </rule>

    <rule e="way" k="highway" v="primary|secondary">
        <line stroke="#005F24" stroke-width="2.7" stroke-linecap="round" />
        <line stroke="#00C84A" stroke-width="1.5" stroke-linecap="round" />
    </rule>

    <rule e="way" k="highway" v="tertiary|motorway_link|trunk_link|primary_link|secondary_link|tertiary_link">
        <line stroke="#004118" stroke-width="1.5" stroke-linecap="round" />
        <line stroke="#008832" stroke-width="0.9" stroke-linecap="round" />
    </rule>

    <rule e="way" k="highway" v="unclassified|residential|living_street|road|pedestrian" zoom-min="11">
        <line stroke="#003B17" stroke-width="0.75" stroke-linecap="round" />
    </rule>

    <rule e="way" k="highway" v="service|track" zoom-min="13">
        <line stroke="#002A10" stroke-width="0.55" stroke-linecap="round" />
    </rule>

    <rule e="way" k="highway" v="cycleway|bridleway|footway|path|steps" zoom-min="14">
        <line stroke="#00220D" stroke-width="0.4" stroke-dasharray="4,5" stroke-linecap="round" />
    </rule>

    <rule e="way" k="railway" v="rail|light_rail|tram|subway|narrow_gauge" zoom-min="11">
        <line stroke="#00451A" stroke-width="0.65" stroke-dasharray="8,5" stroke-linecap="butt" />
    </rule>

    <rule e="way" k="boundary" v="administrative">
        <rule e="way" k="admin_level" v="2">
            <line stroke="#002B10" stroke-width="4.0" stroke-dasharray="14,8" stroke-linecap="butt" />
            <line stroke="#16FF62" stroke-width="1.6" stroke-dasharray="14,8" stroke-linecap="butt" />
        </rule>
        <rule e="way" k="admin_level" v="4" zoom-min="8">
            <line stroke="#007A2C" stroke-width="1.1" stroke-dasharray="10,8" stroke-linecap="butt" />
        </rule>
    </rule>
</rendertheme>
